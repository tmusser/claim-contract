{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tmusser/claim-contract/blob/main/schemas/evidence-receipts-v1.schema.json",
  "title": "claim-contract evidence receipts v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "scientific_validation",
    "automatic_verification",
    "scope_notice",
    "contract",
    "snapshot",
    "receipts"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "type": {"const": "claim_contract.evidence_receipts"},
    "scientific_validation": {"const": false},
    "automatic_verification": {"const": false},
    "scope_notice": {
      "type": "string",
      "minLength": 1,
      "pattern": "does not verify"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_binding"],
      "properties": {
        "input_binding": {"$ref": "#/$defs/inputBinding"}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_revision"],
      "properties": {
        "repository_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "receipts": {
      "type": "array",
      "items": {"$ref": "#/$defs/receipt"}
    }
  },
  "$defs": {
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "contract_sha256"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalization": {"const": "parsed-contract-v1"},
        "contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "refs"],
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^evidence\\.[A-Za-z0-9_.-]+$"
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "note": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    }
  }
}
