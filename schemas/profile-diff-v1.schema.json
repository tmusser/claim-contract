{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tmusser/claim-contract/blob/main/schemas/profile-diff-v1.schema.json",
  "title": "claim-contract profile diff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "tool",
    "scientific_validation",
    "automatic_compatibility_classification",
    "scope_notice",
    "not_evaluated",
    "before",
    "after",
    "semantic_changed",
    "tool_metadata_changed",
    "change_count",
    "profile_changes",
    "rules_added",
    "rules_removed",
    "rules_changed",
    "rule_order"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "type": {"const": "claim_contract.profile_diff"},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "claim-contract"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "scientific_validation": {"const": false},
    "automatic_compatibility_classification": {"const": false},
    "scope_notice": {"type": "string", "minLength": 1},
    "not_evaluated": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "before": {"$ref": "#/$defs/profile_identity"},
    "after": {"$ref": "#/$defs/profile_identity"},
    "semantic_changed": {"type": "boolean"},
    "tool_metadata_changed": {"type": "boolean"},
    "change_count": {"type": "integer", "minimum": 0},
    "profile_changes": {
      "type": "array",
      "items": {"$ref": "#/$defs/profile_change"}
    },
    "rules_added": {
      "type": "array",
      "items": {"$ref": "#/$defs/rule"}
    },
    "rules_removed": {
      "type": "array",
      "items": {"$ref": "#/$defs/rule"}
    },
    "rules_changed": {
      "type": "array",
      "items": {"$ref": "#/$defs/rule_change"}
    },
    "rule_order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed", "before", "after"],
      "properties": {
        "changed": {"type": "boolean"},
        "before": {
          "type": "array",
          "items": {"type": "string", "pattern": "^CC[0-9]{3}$"}
        },
        "after": {
          "type": "array",
          "items": {"type": "string", "pattern": "^CC[0-9]{3}$"}
        }
      }
    }
  },
  "$defs": {
    "profile_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "profile_manifest_binding"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "profile_manifest_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "canonicalization", "profile_manifest_sha256"],
          "properties": {
            "algorithm": {"const": "sha256"},
            "canonicalization": {"const": "profile-manifest-semantics-v1"},
            "profile_manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "profile_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "before", "after"],
      "properties": {
        "path": {
          "enum": [
            "profile.name",
            "profile.contract_schema",
            "profile.description",
            "scope_notice",
            "not_evaluated"
          ]
        },
        "before": {},
        "after": {}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "consumed_fields", "trigger", "known_boundary"],
      "properties": {
        "id": {"type": "string", "pattern": "^CC[0-9]{3}$"},
        "severity": {"enum": ["REVIEW", "BLOCK"]},
        "consumed_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "trigger": {"type": "string", "minLength": 1},
        "known_boundary": {"type": "string", "minLength": 1}
      }
    },
    "rule_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "changes"],
      "properties": {
        "id": {"type": "string", "pattern": "^CC[0-9]{3}$"},
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "before", "after"],
            "properties": {
              "field": {
                "enum": ["severity", "consumed_fields", "trigger", "known_boundary"]
              },
              "before": {},
              "after": {}
            }
          }
        }
      }
    }
  }
}
