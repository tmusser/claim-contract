{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tmusser/claim-contract/blob/main/schemas/rule-trace-v1.schema.json",
  "title": "claim-contract rule trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "tool",
    "contract",
    "verdict",
    "profile",
    "claim_text",
    "scientific_validation",
    "automatic_interpretation",
    "scope_notice",
    "not_evaluated",
    "summary",
    "rules"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "type": {"const": "claim_contract.rule_trace"},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "claim-contract"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "input_binding", "profile_manifest_binding"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "input_binding": {"$ref": "#/$defs/inputBinding"},
        "profile_manifest_binding": {"$ref": "#/$defs/profileBinding"}
      }
    },
    "verdict": {"enum": ["READY", "REVIEW", "BLOCK"]},
    "profile": {"type": "string", "minLength": 1},
    "claim_text": {"type": "string"},
    "scientific_validation": {"const": false},
    "automatic_interpretation": {"const": false},
    "scope_notice": {
      "type": "string",
      "minLength": 1,
      "pattern": "not scientific validation"
    },
    "not_evaluated": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_count",
        "triggered_count",
        "pass_count",
        "not_applicable_count",
        "finding_count"
      ],
      "properties": {
        "rule_count": {"type": "integer", "minimum": 1},
        "triggered_count": {"type": "integer", "minimum": 0},
        "pass_count": {"type": "integer", "minimum": 0},
        "not_applicable_count": {"type": "integer", "minimum": 0},
        "finding_count": {"type": "integer", "minimum": 0}
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ruleTraceEntry"}
    }
  },
  "$defs": {
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "contract_sha256"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalization": {"const": "parsed-contract-v1"},
        "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "profileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "profile_manifest_sha256"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalization": {"const": "profile-manifest-semantics-v1"},
        "profile_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "severity", "path", "message", "action"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^CC[0-9]{3}$"},
        "severity": {"enum": ["REVIEW", "BLOCK"]},
        "path": {"type": "string"},
        "message": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1}
      }
    },
    "ruleTraceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "status",
        "consumed_fields",
        "profile_trigger",
        "known_boundary",
        "reason",
        "finding_count",
        "findings"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^CC[0-9]{3}$"},
        "severity": {"enum": ["REVIEW", "BLOCK"]},
        "status": {"enum": ["TRIGGERED", "PASS", "NOT_APPLICABLE"]},
        "consumed_fields": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "profile_trigger": {"type": "string", "minLength": 1},
        "known_boundary": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "finding_count": {"type": "integer", "minimum": 0},
        "findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"}
        }
      }
    }
  }
}
