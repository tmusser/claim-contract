{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tmusser/claim-contract/blob/main/schemas/chart-handoff-v1.schema.json",
  "title": "claim-contract chart handoff v1",
  "description": "Bound claim context exported for chart-contract. This artifact carries declared analytical scope and claim-contract validation status; it does not recommend or authorize a chart design.",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "tool",
    "destination",
    "claim",
    "evidence_context",
    "validation",
    "contract"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "type": {"const": "claim_contract.chart_handoff"},
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "claim-contract"},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "destination": {
      "type": "object",
      "required": ["tool", "purpose"],
      "properties": {
        "tool": {"const": "chart-contract"},
        "purpose": {"const": "bounded_claim_context"}
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["text", "metric", "population", "time_window"],
      "properties": {
        "text": {"type": ["string", "null"]},
        "metric": {
          "type": "object",
          "required": ["name", "unit"],
          "properties": {
            "name": {"type": ["string", "null"]},
            "unit": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "population": {"type": ["string", "null"]},
        "time_window": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "evidence_context": {
      "type": "object",
      "required": ["provenance_source", "caveats"],
      "properties": {
        "provenance_source": {"type": ["string", "null"]},
        "caveats": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": [
        "verdict",
        "profile",
        "scientific_validation",
        "scope_notice",
        "not_evaluated",
        "summary",
        "findings"
      ],
      "properties": {
        "verdict": {"enum": ["READY", "REVIEW", "BLOCK"]},
        "profile": {"type": "string", "minLength": 1},
        "scientific_validation": {"const": false},
        "scope_notice": {
          "type": "string",
          "minLength": 1,
          "pattern": "not scientific validation"
        },
        "not_evaluated": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "summary": {
          "type": "object",
          "required": ["finding_count", "review_count", "block_count"],
          "properties": {
            "finding_count": {"type": "integer", "minimum": 0},
            "review_count": {"type": "integer", "minimum": 0},
            "block_count": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule_id", "severity", "path", "message", "action"],
            "properties": {
              "rule_id": {"type": "string", "pattern": "^CC[0-9]{3}$"},
              "severity": {"enum": ["REVIEW", "BLOCK"]},
              "path": {"type": "string"},
              "message": {"type": "string", "minLength": 1},
              "action": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "required": ["profile", "input_binding"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "input_binding": {
          "type": "object",
          "required": ["algorithm", "canonicalization", "contract_sha256"],
          "properties": {
            "algorithm": {"const": "sha256"},
            "canonicalization": {"const": "parsed-contract-v1"},
            "contract_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
