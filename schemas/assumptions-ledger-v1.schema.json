{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tmusser/claim-contract/blob/main/schemas/assumptions-ledger-v1.schema.json",
  "title": "claim-contract assumptions ledger v1",
  "description": "A bound sidecar ledger for making analytical assumptions explicit and reviewable without automatically adjudicating them or changing claim-contract verdicts.",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "scope_notice",
    "scientific_validation",
    "automatic_adjudication",
    "mutates_contract",
    "contract",
    "claim_text",
    "assumptions"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "type": {"const": "claim_contract.assumptions_ledger"},
    "scope_notice": {
      "type": "string",
      "minLength": 1,
      "pattern": "not scientific validation"
    },
    "scientific_validation": {"const": false},
    "automatic_adjudication": {"const": false},
    "mutates_contract": {"const": false},
    "contract": {
      "type": "object",
      "required": ["version", "profile", "input_binding", "profile_manifest_binding"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "input_binding": {
          "type": "object",
          "required": ["algorithm", "canonicalization", "contract_sha256"],
          "properties": {
            "algorithm": {"const": "sha256"},
            "canonicalization": {"const": "parsed-contract-v1"},
            "contract_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "profile_manifest_binding": {
          "type": "object",
          "required": ["algorithm", "canonicalization", "profile_manifest_sha256"],
          "properties": {
            "algorithm": {"const": "sha256"},
            "canonicalization": {"const": "profile-manifest-semantics-v1"},
            "profile_manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "claim_text": {"type": "string", "minLength": 1},
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/assumption"}
    }
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "assumptionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "evidenceState": {
      "type": "object",
      "required": ["refs", "validation_method", "last_checked_at", "note"],
      "properties": {
        "refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonEmptyString"},
          "uniqueItems": true
        },
        "validation_method": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "last_checked_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "note": {
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "reviewRecord": {
      "type": "object",
      "required": ["reviewed_at", "reviewed_by", "evidence_refs", "note"],
      "properties": {
        "reviewed_at": {"type": "string", "format": "date-time"},
        "reviewed_by": {"$ref": "#/$defs/nonEmptyString"},
        "evidence_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonEmptyString"},
          "uniqueItems": true
        },
        "note": {"$ref": "#/$defs/nonEmptyString"}
      },
      "additionalProperties": false
    },
    "challengeRecord": {
      "type": "object",
      "required": ["challenged_at", "challenged_by", "evidence_refs", "reason"],
      "properties": {
        "challenged_at": {"type": "string", "format": "date-time"},
        "challenged_by": {"$ref": "#/$defs/nonEmptyString"},
        "evidence_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonEmptyString"},
          "uniqueItems": true
        },
        "reason": {"$ref": "#/$defs/nonEmptyString"}
      },
      "additionalProperties": false
    },
    "retirementRecord": {
      "type": "object",
      "required": ["retired_at", "retired_by", "reason"],
      "properties": {
        "retired_at": {"type": "string", "format": "date-time"},
        "retired_by": {"$ref": "#/$defs/nonEmptyString"},
        "reason": {"$ref": "#/$defs/nonEmptyString"}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["recorded_at", "source_refs"],
      "properties": {
        "recorded_at": {"type": "string", "format": "date-time"},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/nonEmptyString"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "assumption": {
      "type": "object",
      "required": [
        "id",
        "aliases",
        "category",
        "role",
        "statement",
        "scope",
        "status",
        "evidence",
        "caveat",
        "invalidation_trigger",
        "provenance",
        "review",
        "challenge",
        "retirement",
        "supersedes"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/assumptionId"},
        "aliases": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonEmptyString"},
          "uniqueItems": true
        },
        "category": {
          "enum": [
            "identifying",
            "measurement",
            "sampling",
            "model",
            "operational",
            "interpretive"
          ]
        },
        "role": {"$ref": "#/$defs/nonEmptyString"},
        "statement": {"$ref": "#/$defs/nonEmptyString"},
        "scope": {"$ref": "#/$defs/nonEmptyString"},
        "status": {"enum": ["OPEN", "REVIEWED", "CHALLENGED", "RETIRED"]},
        "evidence": {"$ref": "#/$defs/evidenceState"},
        "caveat": {"type": ["string", "null"], "minLength": 1},
        "invalidation_trigger": {"$ref": "#/$defs/nonEmptyString"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "review": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/reviewRecord"}
          ]
        },
        "challenge": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/challengeRecord"}
          ]
        },
        "retirement": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/retirementRecord"}
          ]
        },
        "supersedes": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/assumptionId"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "OPEN"}}, "required": ["status"]},
          "then": {
            "properties": {
              "review": {"type": "null"},
              "challenge": {"type": "null"},
              "retirement": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "REVIEWED"}}, "required": ["status"]},
          "then": {
            "properties": {
              "review": {"$ref": "#/$defs/reviewRecord"},
              "challenge": {"type": "null"},
              "retirement": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "CHALLENGED"}}, "required": ["status"]},
          "then": {
            "properties": {
              "review": {"$ref": "#/$defs/reviewRecord"},
              "challenge": {"$ref": "#/$defs/challengeRecord"},
              "retirement": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "RETIRED"}}, "required": ["status"]},
          "then": {
            "properties": {
              "retirement": {"$ref": "#/$defs/retirementRecord"}
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}