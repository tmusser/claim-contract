{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tmusser/claim-contract/blob/main/schemas/evidence-receipt-inspection-v1.schema.json",
  "title": "claim-contract evidence receipt inspection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "tool",
    "scientific_validation",
    "automatic_verification",
    "changes_validation_verdict",
    "scope_notice",
    "contract",
    "snapshot",
    "summary",
    "coverage",
    "unused_receipts"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "type": {"const": "claim_contract.evidence_receipt_inspection"},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "claim-contract"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "scientific_validation": {"const": false},
    "automatic_verification": {"const": false},
    "changes_validation_verdict": {"const": false},
    "scope_notice": {
      "type": "string",
      "minLength": 1,
      "pattern": "not scientific validation"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_match",
        "saved_input_binding",
        "current_input_binding",
        "profile",
        "profile_manifest_binding"
      ],
      "properties": {
        "binding_match": {"type": "boolean"},
        "saved_input_binding": {"$ref": "#/$defs/inputBinding"},
        "current_input_binding": {"$ref": "#/$defs/inputBinding"},
        "profile": {"type": "string", "minLength": 1},
        "profile_manifest_binding": {"$ref": "#/$defs/profileBinding"}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_revision",
        "revision_resolves",
        "missing_refs",
        "invalid_refs"
      ],
      "properties": {
        "repository_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "revision_resolves": {"type": "boolean"},
        "missing_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "invalid_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integrity_ok",
        "applicable_evidence_field_count",
        "receipted_count",
        "unreceipted_count",
        "unused_receipt_count"
      ],
      "properties": {
        "integrity_ok": {"type": "boolean"},
        "applicable_evidence_field_count": {"type": "integer", "minimum": 0},
        "receipted_count": {"type": "integer", "minimum": 0},
        "unreceipted_count": {"type": "integer", "minimum": 0},
        "unused_receipt_count": {"type": "integer", "minimum": 0}
      }
    },
    "coverage": {
      "type": "array",
      "items": {"$ref": "#/$defs/coverage"}
    },
    "unused_receipts": {
      "type": "array",
      "items": {"$ref": "#/$defs/receipt"}
    }
  },
  "$defs": {
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "contract_sha256"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalization": {"const": "parsed-contract-v1"},
        "contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "profileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "profile_manifest_sha256"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalization": {"const": "profile-manifest-semantics-v1"},
        "profile_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "status",
        "applicable_rule_ids",
        "refs",
        "refs_resolve"
      ],
      "properties": {
        "field": {"type": "string", "pattern": "^evidence\\."},
        "status": {"enum": ["RECEIPTED", "UNRECEIPTED"]},
        "applicable_rule_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^CC[0-9]{3}$"}
        },
        "refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "refs_resolve": {"type": ["boolean", "null"]}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "refs"],
      "properties": {
        "field": {"type": "string", "pattern": "^evidence\\."},
        "refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "note": {"type": "string", "minLength": 1}
      }
    }
  }
}
